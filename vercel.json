{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd admin-panel && npm ci && npm run build && rm -rf ../api/admin-dist && cp -r dist ../api/admin-dist",
  "functions": {
    "api/main.py": {
      "excludeFiles": "{admin-panel/**,tests/**,.venv/**,data/**,.omo/**,**/__pycache__/**,.git/**,docs/**,.github/**,.claude/**,.codex/**,.cursor/**,.kombai/**,.impeccable/**,alembic/**,*.db,*.sqlite3}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/main.py"
    }
  ]
}
