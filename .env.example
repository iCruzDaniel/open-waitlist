# === Database ===
DATABASE_TYPE=sqlite           # sqlite | postgres | redis
DATABASE_URL=sqlite+aiosqlite:///./data/waitlist.db
# DATABASE_URL=postgresql+asyncpg://openwaitlist:changeme-db-password@db:5432/openwaitlist
# POSTGRES_PASSWORD=changeme-db-password   # para --profile postgres; debe coincidir con DATABASE_URL

# === Redis (Upstash) — solo cuando DATABASE_TYPE=redis ===
# Redis reemplaza totalmente a SQLAlchemy. Requiere este par URL+token de Upstash.
REDIS_URL=                      # https://...upstash.io (REST URL de la base)
REDIS_TOKEN=                    # token REST de la base Upstash
REDIS_NAMESPACE_ORG=waitlistgo  # namespace que prefija todas las claves (aislamiento multi-tenant)

# === Demo mode (landing de prueba con datos aleatorios) ===
DEMO_MODE=false                 # true sirve un formulario de leads en / con botón "Random"
DEMO_SLUG=demo                  # slug de la waitlist a la que apunta el formulario demo
DEMO_TITLE=Join the demo waitlist

# === Ports (host bind) ===
API_PORT=8000                  # Puerto host para la API
DB_PORT=5432                   # Puerto host para PostgreSQL

# === Docker image tag (docker-compose) ===
IMAGE_TAG=latest               # Tag de dcruz04/waitlistgo a usar; fija un release (p. ej. v1.2.3) en prod

# === Bot protection (Cloudflare Turnstile) ===
TURNSTILE_SITE_KEY=            # Site key pública — va en las landings (widget), nunca en el backend
TURNSTILE_SECRET_KEY=          # Secret key — solo backend. Vacío = verificación desactivada (dev)
TURNSTILE_ALLOWED_HOSTNAMES=   # Opcional: hostnames permitidos separados por coma (validación de origen)

# === Auth ===
JWT_SECRET=changeme-jwt-secret # Secreto para JWT del panel admin
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440        # 24h

# === Admin ===
ENABLE_ADMIN_PANEL=false       # true para servir el panel en /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin-password

# === Docs ===
ENABLE_DOCS=false              # true para habilitar /docs y /redoc

# === Rate Limiting ===
RATE_LIMIT_ENTRIES=10/minute   # rate limit para POST /entries
RATE_LIMIT_LOGIN=5/minute      # rate limit para POST /auth/login

# === Notifications ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
NOTIFY_EMAIL_TO=admin@example.com
WEBHOOK_URL=

# === Logging ===
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# === Export CSV ===
EXPORT_DIR=data/exports        # Directory for exported CSV files
EXPORT_TTL_MINUTES=60          # Time-to-live for export jobs (minutes)
