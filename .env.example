# === Database ===
DATABASE_TYPE=sqlite           # sqlite | postgres
DATABASE_URL=sqlite+aiosqlite:///./data/waitlist.db
# DATABASE_URL=postgresql+asyncpg://openwaitlist:changeme-db-password@db:5432/openwaitlist

# === Ports (host bind) ===
API_PORT=8000                  # Puerto host para la API
DB_PORT=5432                   # Puerto host para PostgreSQL

# === Auth ===
API_KEY=changeme-api-key      # API Key para endpoints públicos (landings)
JWT_SECRET=changeme-jwt-secret # Secreto para JWT del panel admin
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440        # 24h

# === Admin ===
ENABLE_ADMIN_PANEL=false       # true para servir el panel en /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin-password

# === Docs ===
ENABLE_DOCS=false              # true para habilitar /docs y /redoc

# === Rate Limiting ===
RATE_LIMIT_ENTRIES=10/minute   # rate limit para POST /entries
RATE_LIMIT_LOGIN=5/minute      # rate limit para POST /auth/login

# === Notifications ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
NOTIFY_EMAIL_TO=admin@example.com
WEBHOOK_URL=

# === Logging ===
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# === Export CSV ===
EXPORT_DIR=data/exports        # Directory for exported CSV files
EXPORT_TTL_MINUTES=60          # Time-to-live for export jobs (minutes)
